"use strict";

/* =============================================================
   UTILITY
   ============================================================= */
const $ = id => document.getElementById(id);

/** Strip HTML tags and trim — prevents XSS in DOM text nodes */
function sanitize(value) {
  return String(value || '').replace(/<[^>]*>/g, '').trim();
}

function wordCount(text) {
  return String(text || '').split(/\s+/).filter(Boolean).length;
}

function hasNumber(text) { return /\d/.test(text); }

function hasEmail(text) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(text); }

function isGarbage(text) {
  const s = String(text || '').toLowerCase().replace(/\s+/g, '');
  if (!s || !/[a-z]/i.test(s)) return true;
  if (/^(.)\1{4,}$/.test(s)) return true;
  if (s.length <= 4 && /^[a-z]+$/.test(s)) return true;
  const letters = s.replace(/[^a-z]/g, '');
  return letters.length >= 6 && new Set(letters).size <= 2;
}

function isMeaningful(text, minWords = 2, minLetters = 5) {
  if (!text || isGarbage(text)) return false;
  return text.replace(/[^a-zA-Z]/g, '').length >= minLetters && wordCount(text) >= minWords;
}

function countItems(text) {
  return String(text || '').split(/[,;\n]/).map(s => s.trim()).filter(s => isMeaningful(s, 1, 2)).length;
}

function hasActionVerb(text) {
  return /\b(organized|organised|created|led|managed|coordinated|researched|designed|developed|built|presented|improved|supported|wrote|planned|negotiated|analyzed|analysed|volunteered|participated)\b/i.test(text);
}

function copyText(elId, btn) {
  const el = $(elId);
  if (!el) return;
  navigator.clipboard.writeText(el.value || el.textContent || '').then(() => {
    if (btn) { const orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = orig, 1800); }
  });
}

function setScore(circleId, scoreId, pct) {
  const deg = Math.round(Math.min(100, Math.max(0, pct)) * 3.6);
  $(circleId).style.background = `conic-gradient(var(--gold) ${deg}deg, rgba(255,255,255,0.10) 0deg)`;
  $(scoreId).textContent = Math.round(pct);
}

function addLi(listId, text, cls) {
  const li = document.createElement('li');
  li.textContent = text;
  if (cls) li.className = cls;
  $(listId).appendChild(li);
}

/* =============================================================
   NAVIGATION
   ============================================================= */
const sections = document.querySelectorAll('.section');
const navBtns  = document.querySelectorAll('.nav-btn');
const menuBtn  = $('menuBtn');
const navMenu  = $('navMenu');

function showSection(id) {
  sections.forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
  navMenu.classList.remove('open');
  menuBtn.setAttribute('aria-expanded', 'false');
  navBtns.forEach(b => b.classList.toggle('active', b.dataset.section === id));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

menuBtn.addEventListener('click', () => {
  const open = navMenu.classList.toggle('open');
  menuBtn.setAttribute('aria-expanded', String(open));
});

document.addEventListener('click', e => {
  if (!menuBtn.contains(e.target) && !navMenu.contains(e.target)) {
    navMenu.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
  }
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    navMenu.classList.remove('open');
    menuBtn.setAttribute('aria-expanded', 'false');
  }
});

/* =============================================================
   DRAFT AUTOSAVE (localStorage)
   PDF Ch.II: "stocarea și utilizarea corectă a resurselor … localStorage"
   ============================================================= */
const EMAIL_FIELDS = ['emailSender','emailTo','emailSubject','emailContext','emailRequest','emailDeadline'];
const CV_FIELDS    = ['cvName','cvTarget','cvEmail','cvPhone','cvLocation','cvLink','cvGoal','cvStrengths',
                      'cvSchool','cvProgram','cvEducationDates','cvEducationDetails',
                      'cvTechnicalSkills','cvSoftSkills','cvLanguages'];

function saveDraft(key, fields, bannerId) {
  try {
    const data = {};
    fields.forEach(id => { const el = $(id); if (el) data[id] = sanitize(el.value); });
    localStorage.setItem(key, JSON.stringify(data));
    const b = $(bannerId);
    if (b) { b.classList.add('visible'); setTimeout(() => b.classList.remove('visible'), 2000); }
  } catch (_) { /* localStorage unavailable — fail silently */ }
}

function loadDraft(key, fields) {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return;
    const data = JSON.parse(raw);
    fields.forEach(id => { const el = $(id); if (el && data[id]) el.value = data[id]; });
  } catch (_) {}
}

function setupAutosave() {
  function debounced(fn, delay) {
    let t; return () => { clearTimeout(t); t = setTimeout(fn, delay); };
  }
  const saveEmail = debounced(() => saveDraft('mp_email_draft', EMAIL_FIELDS, 'emailDraftBanner'), 1200);
  const saveCV    = debounced(() => saveDraft('mp_cv_draft',    CV_FIELDS,    'cvDraftBanner'),    1200);

  EMAIL_FIELDS.forEach(id => { const el = $(id); if (el) el.addEventListener('input', saveEmail); });
  CV_FIELDS.forEach(   id => { const el = $(id); if (el) el.addEventListener('input', saveCV);    });

  loadDraft('mp_email_draft', EMAIL_FIELDS);
  loadDraft('mp_cv_draft',    CV_FIELDS);
}

/* =============================================================
   EMAIL MODULE
   ============================================================= */
function analyzeEmail() {
  const d = {
    sender:    sanitize($('emailSender').value),
    recipient: sanitize($('emailTo').value),
    purpose:   $('emailPurpose').value,
    tone:      $('emailTone').value,
    subject:   sanitize($('emailSubject').value),
    context:   sanitize($('emailContext').value),
    request:   sanitize($('emailRequest').value),
    deadline:  sanitize($('emailDeadline').value)
  };

  $('emailSuggestions').innerHTML = '';

  if (!d.sender && !d.recipient && !d.subject && !d.context && !d.request) {
    setScore('emailScoreCircle', 'emailScore', 0);
    $('emailAdvice').textContent = 'Add information before generating.';
    $('emailSuggestions').innerHTML = '<li class="sug-bad">Nothing completed yet. Add at least recipient, subject, context and request.</li>';
    $('emailOutput').textContent = 'Your formal email will appear here.';
    return;
  }

  let score = 0;

  if (d.sender)   { score += 8; } else addLi('emailSuggestions', 'Add your name so the closing is complete.', 'sug-warn');
  if (d.recipient){ score += 10;} else addLi('emailSuggestions', 'Add a clear recipient.', 'sug-warn');

  if (d.subject && wordCount(d.subject) >= 3) { score += 12; }
  else addLi('emailSuggestions', 'Write a specific subject — avoid vague ones like "Question".', 'sug-bad');

  if (wordCount(d.context) >= 18) { score += 18; }
  else if (d.context) { score += 9; addLi('emailSuggestions', 'Add more context so the recipient understands quickly.', 'sug-warn'); }
  else addLi('emailSuggestions', 'Add context — explain the situation in 2–3 sentences.', 'sug-bad');

  if (wordCount(d.request) >= 12) { score += 22; }
  else if (d.request) { score += 10; addLi('emailSuggestions', 'Make the request more precise — say exactly what you need.', 'sug-warn'); }
  else addLi('emailSuggestions', 'Add your main request — a formal email must clearly state what you need.', 'sug-bad');

  if (d.deadline) { score += 8; } else addLi('emailSuggestions', 'Add a deadline or preferred time if relevant.', 'sug-warn');

  if (d.context && d.request && d.recipient && d.subject) score += 12;
  if ((d.context + d.request).length > 900) { score -= 8; addLi('emailSuggestions', 'The email may be too long — keep it concise.', 'sug-warn'); }
  if (/!/.test(d.context + d.request))       { score -= 5; addLi('emailSuggestions', 'Avoid exclamation marks in formal emails.', 'sug-warn'); }

  score = Math.round(Math.max(0, Math.min(100, score)));
  setScore('emailScoreCircle', 'emailScore', score);

  $('emailAdvice').textContent =
    score < 45 ? 'Needs more structure. Add a subject, context and a clear request.' :
    score < 75 ? 'Good start. Improve clarity and add any missing details.' :
                 'Strong email. Check spelling and do a final read before sending.';

  if (!$('emailSuggestions').children.length)
    addLi('emailSuggestions', 'Excellent structure — clear subject, polite tone, context and request all included.', 'sug-good');

  $('emailOutput').textContent = buildEmail(d);
}

function buildEmail(d) {
  const recipient = d.recipient || 'Sir/Madam';
  const sender    = d.sender   || '[Your Name]';
  const subject   = d.subject  || getDefaultSubject(d.purpose);
  const context   = d.context  || '[Add context here.]';
  const request   = d.request  || '[Add your request here.]';

  const tones = {
    formal:  ['I hope this message finds you well.', 'I would be grateful if you could', 'Thank you for your time and consideration.', 'Kind regards,'],
    warm:    ['I hope you are doing well.',           'I would really appreciate it if you could', 'Thank you very much for your help.', 'Best regards,'],
    concise: ['I am writing regarding the matter below.', 'Please', 'Thank you.', 'Regards,']
  };
  const t = tones[d.tone] || tones.formal;

  const purposes = {
    'ask for information':      ['ask for information regarding',       'clarify',                     'This information would help me prepare properly.'],
    'request a meeting':        ['request a meeting regarding',         'discuss',                     'A short meeting would help me understand the next steps.'],
    'send an assignment':       ['send my assignment regarding',        'review',                      'Please let me know if additional information is needed.'],
    'apply for an opportunity': ['apply for the opportunity related to','consider my application because','I would be glad to provide any extra details.'],
    'apologise for a delay':    ['apologise for the delay regarding',   'understand that',             'I apologise for any inconvenience caused.'],
    'follow up politely':       ['politely follow up on',               'share updates about',         'This would help me plan my next steps.']
  };
  const [action, verb, extra] = purposes[d.purpose] || ['write regarding', 'help with', ''];
  const deadline = d.deadline ? `\n\nIf possible, I would appreciate a response ${d.deadline}.` : '';

  return `Subject: ${subject}\n\nDear ${recipient},\n\n${t[0]}\n\nI am writing to ${action} ${context}\n\n${t[1]} ${verb} ${request}? ${extra}${deadline}\n\n${t[2]}\n\n${t[3]}\n${sender}`;
}

function getDefaultSubject(purpose) {
  const map = {
    'ask for information':      'Request for information',
    'request a meeting':        'Meeting request',
    'send an assignment':       'Assignment submission',
    'apply for an opportunity': 'Application for opportunity',
    'apologise for a delay':    'Apology for delay',
    'follow up politely':       'Follow-up on previous message'
  };
  return map[purpose] || (purpose.charAt(0).toUpperCase() + purpose.slice(1));
}

function clearEmailForm() {
  EMAIL_FIELDS.forEach(id => { const el = $(id); if (el) el.value = ''; });
  $('emailPurpose').value = 'ask for information';
  $('emailTone').value    = 'formal';
  setScore('emailScoreCircle', 'emailScore', 0);
  $('emailAdvice').textContent = 'Complete the form and press Generate & check.';
  $('emailSuggestions').innerHTML = '<li>Your feedback will appear here.</li>';
  $('emailOutput').textContent = 'Your formal email will appear here.';
  try { localStorage.removeItem('mp_email_draft'); } catch (_) {}
}

/* =============================================================
   CV MODULE
   ============================================================= */
let cvExperiences = [];

/** Add a new experience entry from the builder fields */
function addExperience() {
  const role    = sanitize($('cvExpRole').value);
  const org     = sanitize($('cvExpOrg').value);
  const period  = sanitize($('cvExpPeriod').value);
  const actions = sanitize($('cvExpActions').value);
  const result  = sanitize($('cvExpResult').value);

  if (!isMeaningful(role, 1, 3) || !isMeaningful(org, 1, 3) || !isMeaningful(actions, 4, 14)) {
    alert('Please fill in Role, Organisation and at least a brief description of what you did.');
    return;
  }

  cvExperiences.push({ role, organization: org, period, actions, result });
  renderExpList();

  /* Clear builder fields after adding */
  ['cvExpRole','cvExpOrg','cvExpPeriod','cvExpActions','cvExpResult'].forEach(id => { const el = $(id); if (el) el.value = ''; });
}

function renderExpList() {
  const list = $('cvExperienceItems');
  list.innerHTML = '';
  cvExperiences.forEach((item, i) => {
    const li = document.createElement('li');
    li.textContent = `${item.role} at ${item.organization}${item.period ? ' (' + item.period + ')' : ''}`;
    li.title = 'Click to remove';
    li.setAttribute('role', 'button');
    li.setAttribute('tabindex', '0');
    li.addEventListener('click',   () => removeExp(i));
    li.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') removeExp(i); });
    list.appendChild(li);
  });
}

function removeExp(i) { cvExperiences.splice(i, 1); renderExpList(); }

function analyzeCV() {
  const d = {
    name:             sanitize($('cvName').value),
    target:           sanitize($('cvTarget').value),
    email:            sanitize($('cvEmail').value),
    phone:            sanitize($('cvPhone').value),
    location:         sanitize($('cvLocation').value),
    link:             sanitize($('cvLink').value),
    goal:             sanitize($('cvGoal').value),
    strengths:        sanitize($('cvStrengths').value),
    school:           sanitize($('cvSchool').value),
    program:          sanitize($('cvProgram').value),
    educationDates:   sanitize($('cvEducationDates').value),
    educationDetails: sanitize($('cvEducationDetails').value),
    technicalSkills:  sanitize($('cvTechnicalSkills').value),
    softSkills:       sanitize($('cvSoftSkills').value),
    languages:        sanitize($('cvLanguages').value),
    experiences:      cvExperiences
  };

  $('cvSuggestions').innerHTML = '';
  $('cvCriteria').innerHTML    = '';

  const hasInput = Object.values(d).filter(v => !Array.isArray(v)).some(Boolean) || d.experiences.length;
  if (!hasInput) {
    setScore('cvScoreCircle', 'cvScore', 0);
    $('cvAdvice').textContent = 'Add real CV information before analysing.';
    $('cvCriteria').innerHTML    = '<li class="crit-fail">No criteria could be evaluated.</li>';
    $('cvSuggestions').innerHTML = '<li class="sug-bad">Nothing completed yet.</li>';
    $('cvPreview').textContent   = 'Your generated CV will appear here.';
    return;
  }

  function criterion(label, pts, max) {
    addLi('cvCriteria', `${label}: ${pts}/${max} pts`,
      pts >= max * .75 ? 'crit-pass' : pts > 0 ? 'crit-mid' : 'crit-fail');
  }

  let score = 0, pts;

  /* Personal details (15 pts) */
  pts = 0;
  if (isMeaningful(d.name, 2, 5) && !hasNumber(d.name)) pts += 4; else addLi('cvSuggestions', 'Use a real full name — no numbers.', 'sug-bad');
  if (isMeaningful(d.target, 2, 8)) pts += 4; else addLi('cvSuggestions', 'Add a clear target role or opportunity.', 'sug-warn');
  if (hasEmail(d.email)) pts += 4; else addLi('cvSuggestions', 'Add a valid email address.', 'sug-bad');
  if (d.phone && hasNumber(d.phone)) pts += 2; else addLi('cvSuggestions', 'Add a phone number.', 'sug-warn');
  if (isMeaningful(d.location, 1, 4) || d.link.length > 8) pts += 1;
  score += pts; criterion('Personal details', pts, 15);

  /* Profile relevance (15 pts) */
  pts = 0;
  if (isMeaningful(d.goal, 10, 35)) pts += 7; else addLi('cvSuggestions', 'Write a real career goal of at least 10 words.', 'sug-warn');
  if (countItems(d.strengths) >= 3) pts += 5; else addLi('cvSuggestions', 'Add at least 3 relevant strengths.', 'sug-warn');
  if (d.target && d.goal.toLowerCase().includes(d.target.split(' ')[0].toLowerCase())) pts += 3;
  score += pts; criterion('Profile relevance', pts, 15);

  /* Education (15 pts) */
  pts = 0;
  if (isMeaningful(d.school, 2, 6)) pts += 4; else addLi('cvSuggestions', 'Add a real school or university name.', 'sug-bad');
  if (isMeaningful(d.program, 2, 6)) pts += 4; else addLi('cvSuggestions', 'Add your profile, degree or specialisation.', 'sug-warn');
  if (hasNumber(d.educationDates) || /present|current/i.test(d.educationDates)) pts += 3; else addLi('cvSuggestions', 'Add education dates, e.g. 2022–present.', 'sug-warn');
  if (isMeaningful(d.educationDetails, 3, 12)) pts += 4; else addLi('cvSuggestions', 'Add relevant subjects or achievements.', 'sug-warn');
  score += pts; criterion('Education', pts, 15);

  /* Experience & activities (25 pts) */
  pts = 0;
  if (d.experiences.length > 0) pts += 10; else addLi('cvSuggestions', 'Add at least one experience, volunteering or club role.', 'sug-bad');
  if (d.experiences.some(e => hasActionVerb(e.actions))) pts += 6; else if (d.experiences.length) addLi('cvSuggestions', 'Use stronger action verbs in experience.', 'sug-warn');
  if (d.experiences.some(e => hasNumber(e.result) || isMeaningful(e.result, 6, 18))) pts += 6; else if (d.experiences.length) addLi('cvSuggestions', 'Add results with numbers if possible.', 'sug-warn');
  if (d.experiences.length >= 2) pts += 3;
  score += pts; criterion('Experience & activities', pts, 25);

  /* Skills (15 pts) */
  pts = 0;
  const techCount = countItems(d.technicalSkills);
  const softCount = countItems(d.softSkills);
  if (techCount >= 3) pts += 7; else addLi('cvSuggestions', 'Add at least 3 technical skills.', 'sug-warn');
  if (softCount >= 3) pts += 5; else addLi('cvSuggestions', 'Add at least 3 soft skills.', 'sug-warn');
  if (techCount + softCount >= 8) pts += 3;
  score += pts; criterion('Skills', pts, 15);

  /* Languages & formatting (15 pts) */
  pts = 0;
  if (countItems(d.languages) >= 2 || /\b(native|b1|b2|c1|c2|a1|a2)\b/i.test(d.languages)) pts += 6; else addLi('cvSuggestions', 'Add languages with levels, e.g. English B2.', 'sug-warn');
  if (score >= 45) pts += 5;
  if (d.experiences.length <= 5 && score >= 45) pts += 4;
  else if (d.experiences.length > 5) addLi('cvSuggestions', 'Keep only the most relevant experiences for a one-page CV.', 'sug-warn');
  score += pts; criterion('Languages & formatting', pts, 15);

  score = Math.round(Math.max(0, Math.min(100, score)));
  setScore('cvScoreCircle', 'cvScore', score);

  $('cvAdvice').textContent =
    score < 40 ? 'Not ready yet — needs real information in all sections.' :
    score < 70 ? 'Good base. Add stronger results and clearer impact.' :
                 'Strong student CV. Polish the wording and tailor it to the opportunity.';

  if (!$('cvSuggestions').children.length)
    addLi('cvSuggestions', 'Great structure. Check grammar, spacing and relevance of every bullet.', 'sug-good');

  $('cvPreview').textContent = buildCV(d);
}

function buildCV(d) {
  const contact  = [d.email, d.phone, d.location, d.link].filter(Boolean).join(' | ');
  const profile  = d.goal && d.strengths
    ? `${d.goal}\nKey strengths: ${d.strengths}.`
    : d.goal || '[Write a focused 2–3 line profile.]';
  const expText  = d.experiences.length
    ? d.experiences.map(e =>
        `${e.role} — ${e.organization}${e.period ? ' | ' + e.period : ''}\n- ${e.actions}${e.result ? '\n  Impact: ' + e.result : ''}`
      ).join('\n\n')
    : '[Add experience, volunteering, club activity or responsibility.]';

  return `${d.name || '[Full Name]'}
${d.target || '[Target role / opportunity]'}
${contact  || '[Email | Phone | Location]'}

PROFILE
${profile}

EDUCATION
${d.school || '[School / University]'}${d.program ? ' — ' + d.program : ''}
${d.educationDates || '[Dates]'}
${d.educationDetails ? '- ' + d.educationDetails : '- [Add relevant subjects or achievements.]'}

EXPERIENCE / ACTIVITIES
${expText}

SKILLS
Technical: ${d.technicalSkills || '[Technical skills]'}
Soft skills: ${d.softSkills    || '[Soft skills]'}

LANGUAGES
${d.languages || '[Languages and levels]'}`;
}

function clearCVForm() {
  [...CV_FIELDS, 'cvExpRole','cvExpOrg','cvExpPeriod','cvExpActions','cvExpResult'].forEach(id => {
    const el = $(id); if (el) el.value = '';
  });
  cvExperiences = [];
  renderExpList();
  setScore('cvScoreCircle', 'cvScore', 0);
  $('cvAdvice').textContent    = 'Complete the form and press Analyse.';
  $('cvCriteria').innerHTML    = '<li>Analysis will appear here.</li>';
  $('cvSuggestions').innerHTML = '<li>Feedback will appear here.</li>';
  $('cvPreview').textContent   = 'Your generated CV will appear here.';
  try { localStorage.removeItem('mp_cv_draft'); } catch (_) {}
}

