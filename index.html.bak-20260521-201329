<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Mr. Premium — a student assistant expert for formal emails, CVs, public speaking, interview preparation, and extracurricular activities.">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline';">
  <title style="white-space: nowrap;">Mr. Premium - Student Assistant Expert</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root {
  --bg:          #07091a;
  --bg2:         #0f1230;
  --bg3:         #1e1040;
  --gold:        #ffd166;
  --gold-light:  #fff0a3;
  --cyan:        #7dd3fc;
  --violet:      #a78bfa;
  --pink:        #f0abfc;
  --green:       #86efac;
  --red:         #fb7185;
  --text:        #f8f7ff;
  --muted:       rgba(248,247,255,0.72);
  --line:        rgba(255,255,255,0.14);
  --card-bg:     rgba(255,255,255,0.08);
  --card-strong: rgba(255,255,255,0.13);
  --shadow:      0 24px 64px rgba(0,0,0,0.45);
  --inner:       inset 0 1px 0 rgba(255,255,255,0.12);
  --radius-lg:   28px;
  --radius-md:   18px;
  --radius-sm:   12px;
  --font:        'Sora', sans-serif;
  --mono:        'DM Mono', monospace;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  min-height: 100vh;
  font-family: var(--font);
  font-size: 16px;
  color: var(--text);
  background:
    radial-gradient(circle at 10% 12%, rgba(167,139,250,.28), transparent 30%),
    radial-gradient(circle at 90% 10%, rgba(255,209,102,.20), transparent 30%),
    radial-gradient(circle at 70% 85%, rgba(125,211,252,.15), transparent 32%),
    linear-gradient(160deg, var(--bg) 0%, var(--bg2) 50%, var(--bg3) 100%);
  background-attachment: fixed;
  overflow-x: hidden;
}

/* Subtle grid overlay */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: radial-gradient(ellipse at center, black 20%, transparent 75%);
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
a { text-decoration: none; color: inherit; }

/* Accessibility: skip link */
.skip-link {
  position: absolute;
  top: -100%;
  left: 0;
  padding: 10px 18px;
  background: var(--gold);
  color: #111;
  font-weight: 700;
  border-radius: 0 0 var(--radius-sm) 0;
  z-index: 999;
  transition: top .2s;
}
.skip-link:focus { top: 0; }

/* ============================================================
   SCROLLBAR
   ============================================================ */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { border-radius: 99px; background: linear-gradient(var(--gold), var(--violet)); }

/* ============================================================
   TOPBAR
   ============================================================ */
.topbar {
  position: sticky;
  top: 14px;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 16px;
  width: min(1200px, calc(100% - 28px));
  margin: 14px auto 0;
  padding: 12px 16px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(7,9,26,.72);
  backdrop-filter: blur(20px);
  box-shadow: var(--shadow), var(--inner);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  font-size: 17px;
  white-space: nowrap;
  flex-shrink: 0;
}

.brand-badge {
  display: grid;
  place-items: center;
  width: 38px; height: 38px;
  border-radius: 13px;
  font-size: 14px;
  font-weight: 800;
  color: #121212;
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  box-shadow: 0 0 24px rgba(255,209,102,.30);
}

.nav {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  justify-content: flex-end;
}

.nav-btn {
  padding: 9px 14px;
  border: 1px solid transparent;
  border-radius: 999px;
  color: var(--muted);
  background: transparent;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
  transition: color .2s, border-color .2s, background .2s, transform .2s;
}
.nav-btn:hover, .nav-btn.active {
  color: var(--text);
  border-color: var(--line);
  background: var(--card-bg);
  transform: translateY(-1px);
}

.menu-btn {
  display: none;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 8px 10px;
  color: var(--text);
  background: var(--card-bg);
  font-size: 20px;
  line-height: 1;
}

/* ============================================================
   LAYOUT
   ============================================================ */
main {
  position: relative;
  z-index: 1;
  width: min(1200px, calc(100% - 28px));
  margin: 0 auto;
}

.section { display: none; padding: 48px 0 72px; }
.section.active { display: block; animation: fadeUp .4s ease both; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border: 1px solid rgba(255,209,102,.32);
  border-radius: 999px;
  color: var(--gold);
  background: rgba(255,209,102,.08);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}
.eyebrow::before {
  content: "";
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 10px var(--gold);
}

.gradient-text {
  background: linear-gradient(135deg, #fff 10%, var(--gold) 42%, var(--pink) 70%, var(--cyan));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

h1 { font-size: clamp(40px, 6.5vw, 82px); line-height: .96; letter-spacing: -2.5px; }
h2 { font-size: clamp(32px, 4.5vw, 62px); line-height: .97; letter-spacing: -1.8px; }
h3 { font-size: 20px; font-weight: 700; margin-bottom: 10px; }

.lead { color: var(--muted); line-height: 1.75; font-size: 17px; margin-top: 14px; }

/* ============================================================
   CARDS & PANELS
   ============================================================ */
.card {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, var(--card-strong), var(--card-bg));
  backdrop-filter: blur(18px);
  box-shadow: var(--shadow), var(--inner);
}
.panel { padding: 26px; }

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 11px 18px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 700;
  transition: transform .22s, box-shadow .22s, border-color .22s, background .22s;
}
.btn-primary {
  color: #141414;
  background: linear-gradient(135deg, var(--gold), var(--gold-light));
  border-color: transparent;
  box-shadow: 0 10px 28px rgba(255,209,102,.22);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 36px rgba(255,209,102,.30); }
.btn-secondary { color: var(--text); background: rgba(255,255,255,.08); }
.btn-secondary:hover { transform: translateY(-2px); border-color: rgba(255,209,102,.40); background: rgba(255,209,102,.10); }
.btn:disabled { opacity: .45; cursor: not-allowed; transform: none !important; box-shadow: none !important; }
.btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 24px;
  padding: 10px 16px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  background: var(--card-bg);
  font-size: 14px;
  font-weight: 600;
  transition: color .2s, border-color .2s, transform .2s;
}
.back-btn:hover { color: var(--text); border-color: rgba(255,209,102,.4); transform: translateX(-3px); }

/* ============================================================
   FORM ELEMENTS
   ============================================================ */
label {
  display: block;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .4px;
  text-transform: uppercase;
  margin-bottom: 7px;
}
label .opt { font-weight: 400; text-transform: none; }

input, select, textarea {
  width: 100%;
  padding: 12px 14px;
  margin-bottom: 16px;
  color: var(--text);
  background: rgba(0,0,0,.26);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
input:focus, select:focus, textarea:focus {
  border-color: rgba(255,209,102,.6);
  box-shadow: 0 0 0 3px rgba(255,209,102,.10);
}
select option { color: #111; background: #fff; }
textarea { resize: vertical; min-height: 88px; }

.form-section-title {
  color: var(--gold);
  font-size: 16px;
  font-weight: 700;
  margin: 18px 0 14px;
}
.form-section-title:first-child { margin-top: 0; }

/* ============================================================
   SECTION HEADING
   ============================================================ */
.section-heading { max-width: 840px; margin-bottom: 32px; }
.section-heading h2 { margin-top: 12px; }

/* ============================================================
   HOME: HERO
   ============================================================ */
.hero {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 28px;
  align-items: center;
  min-height: calc(100vh - 130px);
  padding: 48px 0 32px;
}
.hero-text { padding: 36px; }
.hero-text h1 { margin-top: 16px; }

.hero-visual { display: grid; place-items: center; position: relative; }
.hero-visual::before {
  content: "";
  position: absolute;
  width: 72%; height: 72%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,209,102,.20), rgba(167,139,250,.10) 50%, transparent 72%);
  filter: blur(2px);
  animation: pulse 5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(.96); opacity: .75; }
  50%       { transform: scale(1.05); opacity: 1; }
}

.mascot-card { text-align: center; padding: 28px; }
.mascot-subtitle { color: var(--muted); font-size: 15px; margin-top: 6px; }
.mascot-h2 { font-size: 26px; }

.mascot-photo {
  display: block;
  width: min(100%, 260px);
  margin: 0 auto 14px;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 30px 40px rgba(0,0,0,.55));
}

/* ============================================================
   HOME: CHOICE GRID
   ============================================================ */
.choice-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 28px;
}
.choice-card {
  min-height: 148px;
  padding: 20px 16px;
  border: 1px solid var(--line);
  border-radius: 26px;
  background: linear-gradient(145deg, var(--card-strong), var(--card-bg));
  box-shadow: var(--shadow), var(--inner);
  color: var(--text);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
  transition: transform .22s, border-color .22s, box-shadow .22s;
  cursor: pointer;
}
.choice-card:hover { transform: translateY(-7px); border-color: rgba(255,209,102,.45); box-shadow: 0 28px 60px rgba(0,0,0,.35); }
.choice-card:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.choice-card strong { font-size: clamp(15px, 1.3vw, 19px); line-height: 1.1; }
.choice-card small  { font-size: 13px; color: var(--muted); line-height: 1.35; }

/* ============================================================
   HOME: LEARNING HUB
   ============================================================ */
.learning { margin-top: 28px; padding: 28px; }
.learning h2 { margin: 12px 0 8px; max-width: 760px; }

.learning-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 22px;
}
.learning-card {
  min-height: 180px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: linear-gradient(160deg, rgba(255,255,255,.12), rgba(255,255,255,.04));
  box-shadow: 0 14px 40px rgba(0,0,0,.22), var(--inner);
  color: var(--text);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  text-align: left;
  cursor: pointer;
  transition: transform .22s, border-color .22s, box-shadow .22s;
}
.learning-card:hover { transform: translateY(-6px); border-color: rgba(255,209,102,.42); box-shadow: 0 22px 56px rgba(0,0,0,.32); }
.learning-card:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
.learning-num {
  display: grid;
  place-items: center;
  width: 38px; height: 38px;
  border-radius: 13px;
  color: #111;
  background: linear-gradient(135deg, var(--gold), var(--cyan));
  font-weight: 800;
  font-size: 14px;
  flex-shrink: 0;
}
.learning-card h3 { font-size: clamp(16px, 1.3vw, 20px); color: #fff9e8; line-height: 1.1; margin: 4px 0 2px; }
.learning-card p  { font-size: 13px; color: var(--muted); line-height: 1.4; }
.learning-cta     { margin-top: auto; font-size: 12px; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: .6px; }

.learning-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 18px;
}
.stat-box { padding: 16px; border: 1px solid var(--line); border-radius: 18px; background: rgba(0,0,0,.16); text-align: center; }
.stat-box strong { display: block; font-size: 30px; color: var(--gold); line-height: 1; }
.stat-box span   { font-size: 13px; color: var(--muted); font-weight: 600; }

/* ============================================================
   DRAFT SAVED BANNER
   ============================================================ */
.draft-banner {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid rgba(134,239,172,.30);
  border-radius: var(--radius-sm);
  background: rgba(134,239,172,.08);
  color: var(--green);
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 16px;
  opacity: 0;
  transition: opacity .4s;
}
.draft-banner.visible { opacity: 1; }

/* ============================================================
   SCORE CIRCLE
   ============================================================ */
.score-circle {
  display: grid;
  place-items: center;
  width: 160px; height: 160px;
  margin: 0 auto 16px;
  border-radius: 50%;
  font-size: 32px;
  font-weight: 800;
  background: conic-gradient(var(--gold) 0deg, rgba(255,255,255,.10) 0deg);
  box-shadow: 0 0 28px rgba(255,209,102,.18), var(--inner);
  transition: background .5s;
  /* Inner ring for visual polish */
  outline: 6px solid rgba(0,0,0,.25);
  outline-offset: -12px;
}

/* ============================================================
   OUTPUT / PREVIEW AREAS
   ============================================================ */
.output-pre {
  width: 100%;
  padding: 18px;
  min-height: 220px;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  font-family: var(--mono);
  font-size: 14px;
  line-height: 1.70;
  color: #fff9e8;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: rgba(0,0,0,.24);
  box-shadow: var(--inner);
}
.output-label {
  display: inline-block;
  margin-bottom: 10px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--gold);
  color: #111;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .5px;
  text-transform: uppercase;
}

/* ============================================================
   SUGGESTION / CRITERIA LISTS
   ============================================================ */
.suggestion-list { list-style: none; padding: 0; }
.suggestion-list li { padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 14px; line-height: 1.55; color: var(--muted); }
.suggestion-list li:last-child { border-bottom: none; }
.sug-good { color: var(--green) !important; }
.sug-warn { color: var(--gold) !important; }
.sug-bad  { color: var(--red) !important; }
.crit-pass { color: var(--green); }
.crit-mid  { color: var(--gold); }
.crit-fail { color: var(--red); }

/* ============================================================
   TWO-COLUMN TOOL LAYOUT
   ============================================================ */
.tool-grid  { display: grid; grid-template-columns: 1.3fr .7fr; gap: 22px; align-items: start; }
.two-col    { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.results-col { display: grid; gap: 18px; }

/* ============================================================
   CV EXPERIENCE BUILDER
   ============================================================ */
.exp-builder {
  margin: 12px 0 22px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(0,0,0,.14);
}
.exp-added { margin-top: 12px; padding-left: 18px; }
.exp-added li { margin-bottom: 6px; font-size: 14px; color: var(--muted); cursor: pointer; }
.exp-added li:hover { color: var(--red); }
.exp-added li:hover::after { content: " (click to remove)"; font-size: 11px; }

/* ============================================================
   SPEAKING & INTERVIEW
   ============================================================ */
.two-panel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.timer {
  font-family: var(--mono);
  font-size: clamp(52px, 8vw, 88px);
  font-weight: 500;
  color: var(--gold);
  text-align: center;
  margin: 18px 0;
  padding: 16px 0;
  letter-spacing: -2px;
  text-shadow: 0 0 24px rgba(255,209,102,.28);
}

.tip-box {
  margin-top: 16px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(0,0,0,.18);
  color: var(--muted);
  font-size: 15px;
  line-height: 1.65;
}
.big-question { font-size: 22px; font-weight: 700; color: var(--text); }

.hint-block { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.hint-block:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.hint-block strong { color: var(--gold); display: block; margin-bottom: 4px; font-size: 14px; text-transform: uppercase; letter-spacing: .5px; }
.hint-block span   { font-size: 14px; color: var(--muted); line-height: 1.6; }

.divider { border: none; border-top: 1px solid var(--line); margin: 22px 0; }

/* ============================================================
   EXTRACURRICULAR
   ============================================================ */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin: 20px 0;
}
.info-card { padding: 20px; border: 1px solid var(--line); border-radius: 22px; background: rgba(0,0,0,.16); }
.info-card h4 { color: var(--gold); font-size: 16px; margin-bottom: 10px; }

.clean-list { list-style: none; padding: 0; }
.clean-list li { padding: 6px 0; font-size: 14px; color: var(--muted); line-height: 1.55; border-bottom: 1px solid rgba(255,255,255,.06); }
.clean-list li:last-child { border-bottom: none; }
.clean-list li::before { content: "→ "; color: var(--gold); }

.example-box { margin-top: 22px; padding: 22px; border: 1px solid rgba(255,209,102,.22); border-radius: 22px; background: rgba(255,209,102,.05); }
.example-box h4 { color: var(--gold); font-size: 18px; margin-bottom: 14px; }
.example-box pre {
  max-height: 520px;
  overflow-y: auto;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  font-family: var(--mono);
  font-size: 13px;
  line-height: 1.72;
  color: #fff9e8;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(0,0,0,.22);
  margin-bottom: 18px;
}
.example-box p { font-size: 14px; color: var(--muted); line-height: 1.65; }
.example-box-footer { margin-top: 18px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.12); }

.mun-heading { font-size: clamp(26px, 3.5vw, 44px); letter-spacing: -1px; margin-bottom: 14px; }
.procedure-text { color: var(--muted); font-size: 14px; line-height: 1.7; }

/* ============================================================
   FOOTER
   ============================================================ */
footer {
  width: min(1200px, calc(100% - 28px));
  margin: 28px auto;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(7,9,26,.52);
  backdrop-filter: blur(14px);
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
  .choice-grid, .learning-grid { grid-template-columns: repeat(3, 1fr); }
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-visual { order: -1; }
  .mascot-photo { max-height: 380px; }
}

@media (max-width: 860px) {
  .nav {
    display: none;
    flex-direction: column;
    align-items: stretch;
    position: absolute;
    left: 14px; right: 14px;
    top: calc(100% + 8px);
    padding: 14px;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(7,9,26,.95);
    backdrop-filter: blur(18px);
  }
  .nav.open { display: flex; }
  .nav-btn { text-align: center; padding: 12px; }
  .menu-btn { display: block; }
